# Публичный домен сайта (Caddy отдаёт фронт, coturn realm, STUN/TURN URL).
# Это URL живого сайта — DNS публичен по определению.
DOMAIN=informatika.meteopavel.space

# Исполнитель кода — за тоннелем на роутере, доступен только со стороны VPS.
# Реальный IP тоннеля подставляешь в свой .env (свои адреса не коммитим).
EXECUTOR_URL=http://<TUNNEL_IP>:8010

# Tutor-LLM — прокси к DeepSeek API (контейнер tutor-llm/ на роутере, как
# executor). webapp дёргает его по внутренней сети, ключ DeepSeek сюда НЕ
# пробрасывается — он живёт только в контейнере tutor-llm.
TUTOR_LLM_URL=http://<TUNNEL_IP>:8011

# Бинды портов executor'а и tutor-llm на адрес тоннеля (awg0) на роутере —
# иначе сервисы были бы видны снаружи. На VPS не нужны.
EXECUTOR_BIND_IP=<TUNNEL_IP>
TUTOR_LLM_BIND_IP=<TUNNEL_IP>

# Ключ DeepSeek — прописывается только в .env на РОУТЕРЕ (где поднимается
# tutor-llm/), на VPS он не нужен. Получить: platform.deepseek.com →
# API Keys. ВАЖНО: не коммитить реальный ключ в env.example.
# DEEPSEEK_API_KEY=sk-...
# Модель DeepSeek: deepseek-chat (быстрый/дешёвый, по умолчанию) или
# deepseek-reasoner (рассуждающий, дороже — для сложных разборов кода).
# DEEPSEEK_MODEL=deepseek-chat

# БД (только на VPS, где реально работает auth/грейдинг) — MySQL на внешнем хостинге.
# DATABASE_URL=mysql+pymysql://<логин>:<пароль>@<хост>:3306/<база>

# Подпись сессионных cookie — сгенерировать самому и никогда не менять на проде
# (смена ключа разлогинит всех): python3 -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=

# --- звонки тьютор-ученик (WebRTC + coturn) ---
# Общий секрет для временных TURN-учёток (TURN REST API / use-auth-secret) —
# один и тот же в app (минтит учётки) и в coturn (--static-auth-secret).
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
# TURN_SECRET=
# Публичный IP VPS — coturn обязан его знать явно (host-networking,
# без этого STUN/TURN будут сообщать клиентам не тот адрес).
# TURN_EXTERNAL_IP=
# STUN/TURN URL, которые видит браузер (порт 3478, тот же домен/IP):
# STUN_URLS=stun:informatika.meteopavel.space:3478
# TURN_URLS=turn:informatika.meteopavel.space:3478?transport=udp,turn:informatika.meteopavel.space:3478?transport=tcp

# --- deploy-local.sh ---
DEPLOY_BRANCH=feature/web-grader
# SSH-алиасы из твоего ~/.ssh/config и пути к репо на каждом хосте.
DEPLOY_ROUTER_ALIAS=<router-ssh-alias>
DEPLOY_ROUTER_REPO_DIR=/opt/python-practice-hub
DEPLOY_FRANKFURT_ALIAS=<vps-ssh-alias>
DEPLOY_FRANKFURT_REPO_DIR=/opt/python-practice-hub
# Путь к общим deploy-хелперам (run_with_heartbeat и др.) — layout у каждого свой.
DEPLOY_HELPERS_FILE=<абсолютный/путь/к/deploy_helpers.sh>

# --- backup (опционально, пока нет секретов кроме .env — см. deploy-local.sh) ---
# ARCHIVE_PASSWORD=
# SECURE_RSYNC_USER=
# SECURE_RSYNC_HOST=
# SECURE_RSYNC_PATH=
